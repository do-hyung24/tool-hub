# Vercel Postgres(Neon) 연결 문자열. Vercel 연동에서 값을 가져와 채워주세요.
DATABASE_URL=

# NextAuth(Auth.js) 세션/JWT 서명에 쓰는 비밀키. `npx auth secret` 또는
# `openssl rand -base64 33`로 생성해서 채워주세요. (필수)
AUTH_SECRET=

# 회원가입 시 이메일 인증 링크 발송에 사용합니다 (https://resend.com).
# 아직 발급 전이라면 비워두면 됩니다 - 실제 발송 대신 콘솔에 인증 링크를 로그로 남깁니다.
RESEND_API_KEY=
# Resend에 도메인을 인증하기 전까지는 비워두면 onboarding@resend.dev로 발송됩니다.
RESEND_FROM_EMAIL=

# 룰기반 스캔에서 판단이 애매한 항목을 Claude로 재검토하는 하이브리드 기능
# 스위치입니다. 1차 스프린트 범위에서는 스텁 상태로 꺼두고, "true"로 설정하면
# 활성화됩니다 (ANTHROPIC_API_KEY도 함께 필요).
ENABLE_LLM_HYBRID=false

# Claude API 키 (ENABLE_LLM_HYBRID=true일 때만 사용됩니다)
# 없으면 정규식 기반 시크릿 검사만 수행하고 AI 리뷰는 건너뜁니다.
ANTHROPIC_API_KEY=

# GitHub 저장소 파일을 가져올 때 사용할 토큰 (선택 사항)
# 없어도 동작하지만, GitHub API 비인증 요청은 시간당 60회로 제한됩니다.
GITHUB_TOKEN=
